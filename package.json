{
  "name": "openbot",
  "version": "1.0.0",
  "description": "Un bot Discord open source : économie, niveaux, boutique, mini-jeux. Une alternative libre et personnalisable à DraftBot.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node -e \"try{try{require('child_process').execSync('icacls \\\"dist\\\" /reset /t /c',{stdio:'ignore'})}catch(e){} require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\" && tsc",
    "clean": "node -e \"try{try{require('child_process').execSync('icacls \\\"dist\\\" /reset /t /c',{stdio:'ignore'})}catch(e){} require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\"",
    "start": "node dist/index.js",
    "deploy": "tsx src/deploy.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "discord-bot",
    "open-source",
    "typescript",
    "economie",
    "rpg",
    "slash-commands"
  ],
  "author": "Hippolyte59",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "tsx": "^4.17.1",
    "typescript": "^5.5.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
