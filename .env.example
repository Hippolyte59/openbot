# ── Discord ──────────────────────────────────────────────────────────────────
# Token du bot : https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=

# Application ID (onglet General Information) — déduit automatiquement par
# `npm run deploy` si absent.
CLIENT_ID=

# ID d'un serveur de test : déploie les commandes instantanément au lieu
# d'attendre jusqu'à 1 h. Laisser vide pour un déploiement global.
GUILD_ID=

# ── Apparence des embeds ─────────────────────────────────────────────────────
EMBED_COLOR=#5865F2
BOT_NAME=OpenBot

# ── Serveur web intégré (wiki, API) ──────────────────────────────────────────
# Port d'écoute du serveur HTTP interne.
WEB_PORT=3000

# URL publique du wiki (derrière un reverse proxy, ex. https://wiki.exemple.com).
# Si vide : http://localhost:<WEB_PORT>
PUBLIC_URL=
